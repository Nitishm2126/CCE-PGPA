# CCE Achieve PGPA Management System - Frontend Environment Variables
# Copy to .env.local for local development. NEVER commit .env.local.

# FastAPI Backend Service Base URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# Firebase Client Web SDK Configuration (Public identifiers only — no private keys)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="cce-pgpa.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="cce-pgpa"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="cce-pgpa.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"
