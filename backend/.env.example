# ==============================================================================
# CCE Achieve PGPA Management System - Backend Environment Configuration
# ==============================================================================
# Copy this file to `backend/.env` and update values with your local configuration.
# NEVER commit the real `.env` file to version control.
#
# ARCHITECTURAL MANDATE:
# All certificate, photo, and supporting document file binaries are stored in
# Google Drive. PostgreSQL stores ONLY structured records and file metadata.
# ==============================================================================

# Application Settings
APP_NAME="CCE Achieve API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL 18 local database: cce_achieve)
# IMPORTANT:
# 1. Do NOT use the postgres superuser account for running the application.
# 2. Create a dedicated least-privilege role (e.g. cce_app_user).
# 3. Replace <APP_USER>, <APP_PASSWORD>, <HOST>, <PORT>, and <DB_NAME> with your actual credentials.
# Format for psycopg 3: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://cce_app_user:YOUR_LOCAL_DB_PASSWORD@localhost:5432/cce_achieve"

# CORS Configuration
# Comma-separated list of allowed origins (e.g., Next.js frontend dev server)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# JWT Authentication Settings
# Generate a secure 32+ character random secret with PowerShell:
# py -3.12 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="replace-with-a-random-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Phase 5: Google Drive Storage Configuration
# 1. Enable Google Drive API in Google Cloud Console.
# 2. Create a Service Account and download its JSON key file.
# 3. Create a dedicated folder in Google Drive and share it (Editor access) with the Service Account email.
# 4. Provide either GOOGLE_SERVICE_ACCOUNT_FILE (path to JSON file) or GOOGLE_SERVICE_ACCOUNT_JSON (raw JSON string).
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
# GOOGLE_SERVICE_ACCOUNT_JSON=""
MAX_UPLOAD_SIZE_MB=10

