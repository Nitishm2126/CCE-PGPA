# ==============================================================================
# CCE Achieve PGPA - Cloudflare Staging Environment Variables Template
# Storage Architecture: Google Drive stores file binaries; D1 stores metadata
# ==============================================================================
APP_NAME="CCE Achieve API (Cloudflare Staging)"
APP_ENV="staging"
DEBUG="true"
API_V1_PREFIX="/api/v1"

# Cloudflare D1 Staging Database (APAC Region)
D1_DATABASE_NAME="cce-pgpa-db-staging"
D1_DATABASE_ID="712c3d22-e6ab-4257-90eb-976626a8511a"

# Permanent Evidence Storage: Google Drive Configuration
# Stored encrypted in D1 oauth_credentials or supplied via secrets
STORAGE_PROVIDER="google_drive"
GOOGLE_DRIVE_FOLDER_ID="YOUR_GOOGLE_DRIVE_FOLDER_ID"
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GOOGLE_OAUTH_REDIRECT_URI="https://cce-pgpa-staging.nitishms007.workers.dev/api/v1/auth/google/callback"
OAUTH_ENCRYPTION_KEY="YOUR_FERNET_OR_AES_ENCRYPTION_KEY"
MAX_UPLOAD_SIZE_MB=5
